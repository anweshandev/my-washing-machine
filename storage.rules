rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── SyncSilo ───
    match /{syncsilo=**} {
      allow read, write, update, delete: if true;
    }

    // ─── Birthday ───
    match /{birthday=**} {
      allow read;
      allow write, delete: if false;
    }

    // ─── LaundryIQ ───
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
